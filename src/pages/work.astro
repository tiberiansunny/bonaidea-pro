---
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
---
<Base title="Work — Bonaidea" description="Selected motion design work for SaaS: product promos, ad variant packs, feature explainers.">
  <section class="page" data-hero>
    <div class="wrap">
      <p class="mono" data-fade>selected work</p>
      <h1 class="display" data-reveal="lines">Work</h1>
      <p class="muted lead" data-fade>New cases are being added. Each one is built in code and delivered in every format the campaign needs.</p>
      <WorkGrid />
    </div>
  </section>
</Base>
<style>
  .page { padding-top: 180px; }
  h1 { margin: 16px 0 24px; }
  .lead { max-width: 560px; margin: 0 0 64px; }
</style>

---
import Base from '../layouts/Base.astro';
---
<Base title="Contact — Bonaidea" description="Tell me about your product and the video you need. Reply within one working day.">
  <section class="page" data-hero>
    <div class="wrap grid">
      <div>
        <p class="mono" data-fade>contact</p>
        <h1 class="display" data-reveal="lines">Let's talk<br/>about your<br/>product.</h1>
        <p class="muted" data-fade>Reply within one working day. Kyiv time, UTC+2.</p>
        <p data-fade><a class="mail" href="mailto:dc@bonaidea.pro" data-magnetic>dc@bonaidea.pro</a></p>
      </div>
      <form class="form" id="brief" data-reveal="up">
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
        <label>Product URL<input name="url" type="url" placeholder="https://" /></label>
        <label>What do you need?
          <select name="type">
            <option>Product promo</option><option>Ad variant pack</option><option>Feature explainer</option><option>Motion kit</option><option>Not sure yet</option>
          </select>
        </label>
        <label>Details<textarea name="details" rows="5" placeholder="Goal, deadline, formats, budget range"></textarea></label>
        <button class="btn" type="submit" data-magnetic>Send brief</button>
        <p class="mono">opens your mail app with the brief filled in</p>
      </form>
    </div>
  </section>
</Base>
<script>
  document.addEventListener('astro:page-load', () => {
    const f = document.getElementById('brief') as HTMLFormElement | null;
    if (!f || f.dataset.bound) return;
    f.dataset.bound = '1';
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const body = [...d.entries()].map(([k, v]) => `${k}: ${v}`).join('\n');
      location.href = `mailto:dc@bonaidea.pro?subject=${encodeURIComponent('Brief: ' + d.get('type'))}&body=${encodeURIComponent(body)}`;
    });
  });
</script>
<style>
  .page { padding-top: 180px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  h1 { margin: 16px 0 32px; }
  .mail { font: 500 clamp(22px, 2.4vw, 32px)/1.2 var(--font-display); border-bottom: 1px solid var(--accent); display: inline-block; }
  .form { display: grid; gap: 18px; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); padding: 36px; }
  label { display: grid; gap: 8px; font-size: 14px; color: var(--ink-muted); }
  input, select, textarea { font: inherit; font-size: 16px; color: var(--ink); background: var(--ground); border: 1px solid var(--hairline); border-radius: var(--r-md); padding: 14px 16px; outline: none; transition: border-color var(--dur-fast) var(--ease-out); }
  input:focus, select:focus, textarea:focus { border-color: var(--accent); }
  .form .btn { justify-self: start; border: 0; cursor: pointer; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
